# Seguridad de la cadena de suministro (especificación 3.11):
# ningún paquete ejecuta scripts de instalación automáticamente.
# Los pocos que lo necesitan (Electron, módulos nativos) se ejecutan de forma
# explícita desde scripts/allowed-install-scripts.mjs, que funciona como lista permitida.
ignore-scripts=true
save-exact=false
engine-strict=true
fund=false
